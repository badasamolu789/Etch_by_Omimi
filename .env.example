# Newsletter Email Provider Configuration
# Choose one provider and configure accordingly

# Resend API (recommended for serverless)
RESEND_API_KEY=your_resend_api_key_here

# SendGrid API
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Mailgun API
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=mg.example.com

# Email defaults
NEWSLETTER_FROM_EMAIL=newsletter@etch.local
NEWSLETTER_FROM_NAME=ETCH Newsletter

# Supabase Edge Function endpoint (after deployment)
NEWSLETTER_ENDPOINT=https://your-project.supabase.co/functions/v1/send-newsletter
