# Set these as Supabase Edge Function secrets, never browser configuration.
RESEND_API_KEY=your_resend_api_key_here
NEWSLETTER_FROM=ETCH Newsletter <newsletter@etchbyomimi.com>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Supabase function runtime.

# Server-only Edge Function secrets (configure in Supabase; never expose in HTML)
ARTICLE_PREVIEW_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCEPTANCE_FROM=ETCH Founding Voices <founding@your-verified-domain.example>

# Build-time public sitemap configuration
ETCH_SITE_URL=https://etchbyomimi.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
